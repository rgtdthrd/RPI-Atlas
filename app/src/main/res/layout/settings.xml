<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!-- Top bar with back button and title -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8F8F8"
        android:padding="16dp"
        tools:ignore="MissingConstraints">

        <!-- Back button -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/x_icon"
            android:contentDescription="@string/back" />

        <!-- Page title -->
        <TextView
            android:id="@+id/setting_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="@string/settings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </RelativeLayout>

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:orientation="vertical"
        android:padding="16dp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="243dp">

        <!-- Single Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <!-- Left Icon -->
            <ImageView
                android:id="@+id/icon_accessibility"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/none"
                android:src="@drawable/accessibility" />

            <!-- Text -->
            <TextView
                android:id="@+id/Accessibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/AccessibilityMode"
                android:textColor="#000000"
                android:textSize="16sp" />

            <!-- Right Component (Example: Switch or Dropdown) -->
            <Switch
                android:id="@+id/Accessibility_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="20dp"
                tools:ignore="UseSwitchCompatOrMaterialXml" />
        </LinearLayout>

        <!-- Repeat for other rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/walking_speed_text"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/none"
                android:src="@drawable/walking_speed" />

            <!-- 下拉菜单 -->
            <TextView
                android:id="@+id/walking_speed_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/walking_speed"
                android:textColor="#000000"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/walking_speed_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:padding="20dp"
                android:contentDescription="@string/walking_speed_spinner_desc"
                android:entries="@array/walking_speed_options"
                android:spinnerMode="dropdown" />


        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>